# Loaded with `uv run --env-file .env <script>`. Never commit .env.

# Application key: creates sessions (client.py) and reads their state (controller).
OPENAI_API_KEY=

# Executor key: the only credential handed to worker sandboxes (as CODEX_API_KEY).
# Restricted key from the same org/project/user: List models -> Read, all else None.
OPENAI_EXECUTOR_API_KEY=

# From `uv run --env-file .env client.py --create-agent sandbox-demo`.
OPENAI_AGENT_ID=

# E2B team key (controller creates and reconnects worker sandboxes).
E2B_API_KEY=

# From OpenAI project settings -> Webhooks, after registering the controller URL.
# Leave empty on the first deploy; set it and redeploy.
OPENAI_WEBHOOK_SECRET=
