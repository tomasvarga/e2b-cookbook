# No repo-root .env — apps/backend/.env is the single key source:
# env.py loads it for the backend runtime, template/build.ts loads it for
# publishing the e2b/openai-agents-api-python-sdk template.
# Set E2B_API_KEY (and OPENAI_API_KEY for the backend) there.

# Backend port (Flask). The web app's Vite proxy targets this.
#PORT=8000
