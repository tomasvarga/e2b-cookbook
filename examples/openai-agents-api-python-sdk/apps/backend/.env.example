# Copy to .env and fill in.
# Single key source for the repo: the backend (env.py) and template
# publishing (template/build.ts) both read this file.
# OPENAI_API_KEY needs Agents API preview access (keys without it 404 on
# every /v1/agents/* route).
OPENAI_API_KEY=sk-...
E2B_API_KEY=e2b_...

# Second OpenAI key, same project, for the EXECUTOR sandboxes. It is handed to
# `codex exec-server` as CODEX_API_KEY, so agent-authored code running in the
# sandbox can read it out of the environment — the dispatcher key above never
# leaves this process. Scope this one down in the OpenAI dashboard. Optional:
# unset means the executor reuses OPENAI_API_KEY (pre-split behaviour).
# OPENAI_EXECUTOR_API_KEY=sk-proj-...

# Launcher for the MCP servers that run as stdio subprocesses inside the
# sandbox (duckduckgo, wikipedia, time). Default `uvx` fetches each one from
# PyPI on first use; point this at a wrapper if the image pins versions or
# runs without egress.
# MCP_STDIO_LAUNCHER=uvx

# Optional overrides (defaults shown)
# AGENTS_API_MODEL=gpt-5.6-sol
# E2B_AGENTS_TEMPLATE=e2b/openai-agents-api-python-sdk-executor
# HOST=127.0.0.1
# PORT=8000

# Control-token auth. Unset locally (loopback only, gate disabled); the E2B
# template's start.sh always writes a token because the sandbox's :8000 proxy
# URL is public. Set WORKBENCH_CONTROL_TOKEN to pin one across a fleet.
# WORKBENCH_CONTROL_TOKEN=
# WORKBENCH_CONTROL_DIR=~/.config/agents-api-workbench
